{
  "name": "talabat-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:copy": "node tools/copy-openapi.mjs",
    "api:generator:build": "node tools/api-generator.mjs build",
    "api:gen:customer": "node tools/api-generator.mjs generate-customer",
    "api:gen": "npm run api:copy && npm run api:generator:build && npm run api:gen:customer",
    "api:verify": "node tools/verify-generated-api.mjs",
    "test:openapi-tools": "npm run api:generator:build && node --test tools/api-generator.test.mjs tools/copy-openapi.test.mjs tools/verify-generated-api.test.mjs",
    "build:customer:production": "ng build customer --configuration production --stats-json && node tools/verify-customer-bundle.mjs",
    "verify:customer-bundle": "node tools/verify-customer-bundle.mjs",
    "e2e:preflight": "playwright test --config playwright.config.ts e2e/preflight.spec.ts",
    "e2e": "playwright test --config playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "oidc-client-ts": "3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "4.12.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
