/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@talabat/api-customer": ["./projects/api-customer/src/index.ts"],
      "@talabat/core-auth": ["./projects/core-auth/src/public-api.ts"],
      "@talabat/core-config": ["./projects/core-config/src/public-api.ts"],
      "@talabat/core-http": ["./projects/core-http/src/public-api.ts"],
      "@talabat/shared-ui": ["./projects/shared-ui/src/public-api.ts"],
      "@talabat/shared-util": ["./projects/shared-util/src/public-api.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/customer/tsconfig.app.json"
    },
    {
      "path": "./projects/customer/tsconfig.spec.json"
    },
    {
      "path": "./projects/core-config/tsconfig.lib.json"
    },
    {
      "path": "./projects/core-config/tsconfig.spec.json"
    },
    {
      "path": "./projects/api-customer/tsconfig.lib.json"
    },
    {
      "path": "./projects/core-auth/tsconfig.lib.json"
    },
    {
      "path": "./projects/core-auth/tsconfig.spec.json"
    },
    {
      "path": "./projects/core-http/tsconfig.lib.json"
    },
    {
      "path": "./projects/core-http/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-util/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-util/tsconfig.spec.json"
    }
  ]
}
