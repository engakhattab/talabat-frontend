{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/customer",
      "sourceRoot": "projects/customer/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/customer/src/main.ts",
            "tsConfig": "projects/customer/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/customer/public"
              }
            ],
            "styles": ["projects/customer/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "customer:build:production"
            },
            "development": {
              "buildTarget": "customer:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "core-config": {
      "projectType": "library",
      "root": "projects/core-config",
      "sourceRoot": "projects/core-config/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core-config/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-config/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core-config/tsconfig.spec.json"
          }
        }
      }
    },
    "api-customer": {
      "projectType": "library",
      "root": "projects/api-customer",
      "sourceRoot": "projects/api-customer/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/api-customer/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api-customer/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "core-auth": {
      "projectType": "library",
      "root": "projects/core-auth",
      "sourceRoot": "projects/core-auth/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core-auth/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-auth/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core-auth/tsconfig.spec.json"
          }
        }
      }
    },
    "core-http": {
      "projectType": "library",
      "root": "projects/core-http",
      "sourceRoot": "projects/core-http/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core-http/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-http/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core-http/tsconfig.spec.json"
          }
        }
      }
    },
    "shared-ui": {
      "projectType": "library",
      "root": "projects/shared-ui",
      "sourceRoot": "projects/shared-ui/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared-ui/tsconfig.spec.json"
          }
        }
      }
    },
    "shared-util": {
      "projectType": "library",
      "root": "projects/shared-util",
      "sourceRoot": "projects/shared-util/src",
      "prefix": "tal",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-util/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-util/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared-util/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
